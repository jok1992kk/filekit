# ---------------------------------------------------------------------------
# WareSnap — environment
#
# Copy to .env.local and fill in. Nothing here is required for the marketing
# site: with no values at all the home page still builds and runs.
#
# Auth and the token ledger arrive in Stage 3 — see SPEC.md §11.
# ---------------------------------------------------------------------------

# --- Auth ------------------------------------------------------------------
# Auth currently runs on the local, file-backed provider in lib/auth/local.ts:
# accounts, sessions and the token ledger live in .data/waresnap.json, which is
# gitignored. Nothing below is needed for sign-up, sign-in, the dashboard, the
# editor or mock checkout — they all work with an empty .env.
#
# Swapping in Supabase means writing lib/auth/supabase.ts against the same
# AuthProvider interface and changing the one export in lib/auth/index.ts.
# The local provider has no email delivery, so there is no address
# confirmation and no password reset yet.

# --- Supabase --------------------------------------------------------------
# Dashboard → Project Settings → API
# Needed once the Supabase auth provider replaces the local one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same page, "service_role". Bypasses RLS — server-side only, never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for auth redirects, canonical URLs,
# the sitemap and OG image URLs.
# Local:      http://localhost:3000
# Production: https://<the domain, still to be chosen — see SPEC.md §1>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend ----------------------------------------------------------------
# resend.com/api-keys
# Confirmation and password-reset mail goes through Supabase Auth, which relays
# via Resend SMTP — that is configured in the Supabase dashboard, not here.
RESEND_API_KEY=
